-- Authority: specs/database/omnillm-schema.sql#inference_requests
-- Claim key: UNIQUE (principal_id, operation_kind, idempotency_key)

CREATE TABLE inference_requests (
  request_id TEXT NOT NULL PRIMARY KEY,
  principal_id TEXT NOT NULL,
  operation_kind TEXT NOT NULL,
  idempotency_key TEXT NOT NULL,
  canonical_request_digest TEXT NOT NULL,
  revision_id TEXT,
  state TEXT NOT NULL,
  resource_version INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

selectByRequestId:
SELECT request_id, principal_id, operation_kind, idempotency_key, canonical_request_digest,
       revision_id, state, resource_version, created_at, updated_at
FROM inference_requests
WHERE request_id = ?;

selectByClaimKey:
SELECT request_id, principal_id, operation_kind, idempotency_key, canonical_request_digest,
       revision_id, state, resource_version, created_at, updated_at
FROM inference_requests
WHERE principal_id = ? AND operation_kind = ? AND idempotency_key = ?;

insertRequest:
INSERT INTO inference_requests(
  request_id, principal_id, operation_kind, idempotency_key, canonical_request_digest,
  revision_id, state, resource_version, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE inference_requests
SET state = ?, updated_at = ?, resource_version = ?
WHERE request_id = ?;
