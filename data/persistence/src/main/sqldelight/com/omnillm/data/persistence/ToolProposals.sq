-- Durable tool proposals (FEAT-TOOLS / ADR-010).
-- Control-plane sole writer; UI never opens this table (INV-001).
-- Arguments stored for host claim recovery; metrics/traces must redacts (FEAT-TOOLS §6).

CREATE TABLE tool_proposals (
  proposal_id TEXT NOT NULL PRIMARY KEY,
  request_id TEXT NOT NULL,
  tool_id TEXT NOT NULL,
  schema_digest TEXT NOT NULL,
  arguments_json TEXT NOT NULL,
  attempt INTEGER NOT NULL DEFAULT 1,
  state TEXT NOT NULL,
  created_at_epoch_ms INTEGER NOT NULL
);

selectByProposalId:
SELECT proposal_id, request_id, tool_id, schema_digest, arguments_json, attempt, state, created_at_epoch_ms
FROM tool_proposals
WHERE proposal_id = ?;

listByRequestId:
SELECT proposal_id, request_id, tool_id, schema_digest, arguments_json, attempt, state, created_at_epoch_ms
FROM tool_proposals
WHERE request_id = ?
ORDER BY created_at_epoch_ms ASC;

upsertProposal:
INSERT OR REPLACE INTO tool_proposals(
  proposal_id, request_id, tool_id, schema_digest, arguments_json, attempt, state, created_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE tool_proposals SET state = ? WHERE proposal_id = ?;

deleteByProposalId:
DELETE FROM tool_proposals WHERE proposal_id = ?;
