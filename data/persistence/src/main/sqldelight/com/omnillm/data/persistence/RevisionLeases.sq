-- Control-plane REVISION_LEASE projection (CORE-MODEL §9 / DATA-OWNERSHIP).
-- Authority base: specs/database/omnillm-schema.sql#revision_leases
-- Extension: installation_id, reference_count, expires_at_monotonic for drain guards.

CREATE TABLE revision_leases (
  lease_id TEXT NOT NULL PRIMARY KEY,
  revision_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  principal_id TEXT NOT NULL,
  runtime_epoch INTEGER NOT NULL,
  state TEXT NOT NULL,
  installation_id TEXT,
  reference_count INTEGER NOT NULL DEFAULT 1,
  expires_at TEXT,
  expires_at_monotonic INTEGER,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

selectByLeaseId:
SELECT lease_id, revision_id, request_id, principal_id, runtime_epoch, state,
       installation_id, reference_count, expires_at, expires_at_monotonic,
       created_at, updated_at
FROM revision_leases
WHERE lease_id = ?;

listActiveByRevisionId:
SELECT lease_id, revision_id, request_id, principal_id, runtime_epoch, state,
       installation_id, reference_count, expires_at, expires_at_monotonic,
       created_at, updated_at
FROM revision_leases
WHERE revision_id = ? AND state IN ('ACTIVE', 'DRAINING')
ORDER BY created_at ASC;

listAll:
SELECT lease_id, revision_id, request_id, principal_id, runtime_epoch, state,
       installation_id, reference_count, expires_at, expires_at_monotonic,
       created_at, updated_at
FROM revision_leases
ORDER BY created_at ASC;

upsertLease:
INSERT INTO revision_leases(
  lease_id, revision_id, request_id, principal_id, runtime_epoch, state,
  installation_id, reference_count, expires_at, expires_at_monotonic,
  created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(lease_id) DO UPDATE SET
  revision_id = excluded.revision_id,
  request_id = excluded.request_id,
  principal_id = excluded.principal_id,
  runtime_epoch = excluded.runtime_epoch,
  state = excluded.state,
  installation_id = excluded.installation_id,
  reference_count = excluded.reference_count,
  expires_at = excluded.expires_at,
  expires_at_monotonic = excluded.expires_at_monotonic,
  updated_at = excluded.updated_at;

deleteByLeaseId:
DELETE FROM revision_leases WHERE lease_id = ?;
