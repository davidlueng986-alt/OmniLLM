-- Authority: specs/database/omnillm-schema.sql#request_attempts
-- PK: (request_id, attempt_no); attempt_no >= 1

CREATE TABLE request_attempts (
  request_id TEXT NOT NULL,
  attempt_no INTEGER NOT NULL,
  runtime_epoch INTEGER NOT NULL,
  worker_instance_id TEXT,
  state TEXT NOT NULL,
  started_at TEXT NOT NULL,
  ended_at TEXT,
  PRIMARY KEY (request_id, attempt_no)
);

selectByRequestId:
SELECT request_id, attempt_no, runtime_epoch, worker_instance_id, state, started_at, ended_at
FROM request_attempts
WHERE request_id = ?
ORDER BY attempt_no ASC;

selectMaxAttemptNo:
SELECT COALESCE(MAX(attempt_no), 0)
FROM request_attempts
WHERE request_id = ?;

insertAttempt:
INSERT INTO request_attempts(
  request_id, attempt_no, runtime_epoch, worker_instance_id, state, started_at, ended_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

endAttempt:
UPDATE request_attempts
SET state = ?, ended_at = ?
WHERE request_id = ? AND attempt_no = ?;
