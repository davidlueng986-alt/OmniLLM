-- Secret Broker key metadata + encrypted key blobs (SEC-PROFILE §5).
-- When Android Keystore holds non-exportable material, ciphertext may be empty
-- and key_storage='ANDROID_KEYSTORE' with keystore_alias set.
-- Encrypted-blob path stores AES-GCM wrapped key bytes (master key outside DB).

CREATE TABLE secret_broker_keys (
  purpose TEXT NOT NULL,
  key_version INTEGER NOT NULL,
  state TEXT NOT NULL,
  created_at_epoch_ms INTEGER NOT NULL,
  rotation_reason TEXT,
  key_storage TEXT NOT NULL,
  keystore_alias TEXT,
  key_ciphertext BLOB,
  PRIMARY KEY (purpose, key_version)
);

selectActiveByPurpose:
SELECT purpose, key_version, state, created_at_epoch_ms, rotation_reason, key_storage,
       keystore_alias, key_ciphertext
FROM secret_broker_keys
WHERE purpose = ? AND state = 'ACTIVE'
LIMIT 1;

selectByPurposeVersion:
SELECT purpose, key_version, state, created_at_epoch_ms, rotation_reason, key_storage,
       keystore_alias, key_ciphertext
FROM secret_broker_keys
WHERE purpose = ? AND key_version = ?;

listByPurpose:
SELECT purpose, key_version, state, created_at_epoch_ms, rotation_reason, key_storage,
       keystore_alias, key_ciphertext
FROM secret_broker_keys
WHERE purpose = ?
ORDER BY key_version ASC;

maxVersion:
SELECT COALESCE(MAX(key_version), 0) AS max_version
FROM secret_broker_keys;

upsertKey:
INSERT INTO secret_broker_keys(
  purpose, key_version, state, created_at_epoch_ms, rotation_reason, key_storage,
  keystore_alias, key_ciphertext
) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(purpose, key_version) DO UPDATE SET
  state = excluded.state,
  created_at_epoch_ms = excluded.created_at_epoch_ms,
  rotation_reason = excluded.rotation_reason,
  key_storage = excluded.key_storage,
  keystore_alias = excluded.keystore_alias,
  key_ciphertext = excluded.key_ciphertext;
