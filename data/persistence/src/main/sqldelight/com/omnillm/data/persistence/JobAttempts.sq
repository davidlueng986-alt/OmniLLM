-- Authority: specs/database/omnillm-schema.sql#job_attempts
-- PK: (job_id, attempt_no); attempt_no >= 1
-- One open attempt per job (ended_at IS NULL) enforced by JobManager.

CREATE TABLE job_attempts (
  job_id TEXT NOT NULL,
  attempt_no INTEGER NOT NULL,
  state TEXT NOT NULL,
  started_at TEXT NOT NULL,
  ended_at TEXT,
  PRIMARY KEY (job_id, attempt_no)
);

selectByJobId:
SELECT job_id, attempt_no, state, started_at, ended_at
FROM job_attempts
WHERE job_id = ?
ORDER BY attempt_no ASC;

insertAttempt:
INSERT INTO job_attempts(
  job_id, attempt_no, state, started_at, ended_at
) VALUES (?, ?, ?, ?, ?);

upsertAttempt:
INSERT INTO job_attempts(
  job_id, attempt_no, state, started_at, ended_at
) VALUES (?, ?, ?, ?, ?)
ON CONFLICT(job_id, attempt_no) DO UPDATE SET
  state = excluded.state,
  started_at = excluded.started_at,
  ended_at = excluded.ended_at;

deleteByJobId:
DELETE FROM job_attempts WHERE job_id = ?;
