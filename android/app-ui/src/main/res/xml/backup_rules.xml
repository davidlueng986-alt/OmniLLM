<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (SEC-PRIVACY §5).
  Private model/trust/token/database must be excluded from backup.
  allowBackup=false on <application>; this file documents the fail-closed inventory
  if backup is ever re-enabled for a non-sensitive subset.
-->
<full-backup-content>
    <!-- Exclude everything by default; no include paths until privacy review. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
