<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction / cloud backup rules (SEC-PRIVACY §5).
  Fail closed: no cloud backup or device-transfer of private app data by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Local device-to-device transfer still excludes secrets/models by default. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
